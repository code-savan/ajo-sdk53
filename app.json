{
  "expo": {
    "name": "Ajo Pay",
    "slug": "ajo-mobile-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/appicon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "ajopay",
    "splash": {
      "image": "./assets/appicon.png",
      "resizeMode": "cover",
      "imageSize": [32, 32],
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codesavan.ajo",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "This app uses Face ID for secure authentication and to protect your account.",
        "NSCameraUsageDescription": "This app uses the camera to let you take and upload profile or document photos.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library so you can select existing photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/appicon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.codesavan.ajo"
    },
    "web": {
      "favicon": "./assets/appicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3ff39fca-24d1-4af6-9c0f-970a8d5a6335"
      }
    },
    "owner": "codesavan",
    "plugins": [
        "expo-secure-store",
        "expo-image-picker",
        "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "This app uses Face ID for secure authentication and to protect your account."
        }
      ],
      "expo-image-picker"
    ],
    "linking": {
      "scheme": "ajopay",
      "prefixes": [
        "ajopay://",
        "https://ajopayy.app"
      ]
    }
  }
}
